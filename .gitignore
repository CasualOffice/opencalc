# Rust
/target/
**/*.rs.bk
Cargo.lock.orig

# Fuzzing artifacts (the fuzz Cargo.lock IS committed)
/fuzz/target/
# Its own workspace, so its own line: these patterns are anchored, and a nested
# `target/` is not covered by the root one (ADR-023).
/desktop/target/
/fuzz/corpus/
/fuzz/artifacts/
/fuzz/coverage/

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/

# WASM build output + demo assets
/webapp/pkg/
/webapp/sample.xlsx
/site/
crates/*/pkg/

# npm package build output — assembled by sdk/build-packages.mjs from webapp/
# and the wasm build. The package.json, README and bin/ are tracked; what they
# ship is not.
/sdk/packages/*/dist/
/sdk/packages/engine/casual_calc_wasm*
/sdk/packages/*/*.tgz
/dist-tarballs/
node_modules/
.claude/

# browser-smoke run output. `package-lock.json` IS committed, so CI installs
# the same Playwright the gate was written against.
/tests/browser/test-results/
/tests/browser/playwright-report/
/tests/browser/blob-report/

# Faces an operator drops in for the headless renderer. The directory and its
# README are tracked; the fonts themselves are a deployment's choice and are
# often large and separately licensed.
/fonts/*
!/fonts/README.md

# The README says `cp .env.example .env`, so this file exists on every machine
# that has run the demo and holds the token-signing secret. Ignoring the
# example would be wrong — it is the documentation — but the filled-in copy is
# a credential.
.env
.env.*
!.env.example

# Tauri writes its capability/permission schemas here at build time. Generated,
# like /desktop/target/ above, and regenerated by `tauri-build` on every build.
/desktop/gen/
