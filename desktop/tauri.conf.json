{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenCalc",
  "version": "0.0.0",
  "identifier": "org.casualoffice.opencalc",
  "build": {
    "frontendDist": "../webapp"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Untitled \u2014 OpenCalc",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 400,
        "resizable": true,
        "url": "editor.html?chrome=native"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "copyright": "Copyright \u00a9 CasualOffice. Licensed under Apache-2.0.",
    "shortDescription": "A spreadsheet that reads and writes .xlsx.",
    "longDescription": "OpenCalc opens, edits and saves Excel workbooks, comma-, tab- and pipe-separated text, with a calculation engine that runs entirely on this machine.",
    "fileAssociations": [
      {
        "ext": [
          "xlsx"
        ],
        "name": "Excel Workbook",
        "description": "Excel Workbook",
        "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
        "role": "Editor",
        "rank": "Default"
      },
      {
        "ext": [
          "xlsm"
        ],
        "name": "Excel Macro-Enabled Workbook",
        "description": "Excel Macro-Enabled Workbook",
        "mimeType": "application/vnd.ms-excel.sheet.macroEnabled.12",
        "role": "Editor",
        "rank": "Default"
      },
      {
        "ext": [
          "ods"
        ],
        "name": "OpenDocument Spreadsheet",
        "description": "OpenDocument Spreadsheet",
        "mimeType": "application/vnd.oasis.opendocument.spreadsheet",
        "role": "Editor",
        "rank": "Default"
      },
      {
        "ext": [
          "csv"
        ],
        "name": "Comma-separated values",
        "description": "Comma-separated values",
        "mimeType": "text/csv",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": [
          "tsv",
          "tab"
        ],
        "name": "Tab-separated values",
        "description": "Tab-separated values",
        "mimeType": "text/tab-separated-values",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": [
          "psv"
        ],
        "name": "Pipe-separated values",
        "description": "Pipe-separated values",
        "role": "Editor",
        "rank": "Alternate"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
