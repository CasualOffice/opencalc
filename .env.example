# OpenCalc demo — copy to `.env` and edit. Every value has a working default;
# what is here is what an operator actually changes.

# ---------------------------------------------------------------------------
# The one you must change before anybody else can reach this
# ---------------------------------------------------------------------------
# Signs the tokens the host mints and the collaboration server verifies. Both
# containers read it, which is why the demo uses a shared secret — a real
# deployment should use OPENCALC_JWKS_URL instead, so the server can verify a
# token and cannot mint one.
OPENCALC_SHARED_SECRET=change-me-before-anyone-else-can-reach-this

# The audience the token must name. Any string, the same on both sides.
OPENCALC_AUDIENCE=opencalc-demo

# ---------------------------------------------------------------------------
# Addresses. The two that get confused are marked.
# ---------------------------------------------------------------------------
# What a BROWSER connects to for co-editing. Behind a reverse proxy this is your
# public URL with `wss://`.
OPENCALC_COLLAB_WS=ws://127.0.0.1:8443/collab

# What the COLLABORATION SERVER calls the host — a container name on the compose
# network, not localhost. Getting this wrong is the classic first failure: the
# server fetches `localhost` and finds itself.
OPENCALC_HOST_INTERNAL=http://host:8080

# Where the host is published on your machine.
OPENCALC_HOST_PORT=8080
OPENCALC_COLLAB_PORT=8443

# ---------------------------------------------------------------------------
# Bounds. The defaults are sensible; these are here so you know they exist.
# ---------------------------------------------------------------------------
OPENCALC_MAX_DOCUMENTS=1000
OPENCALC_MAX_PARTICIPANTS=200
OPENCALC_IDLE_EVICTION_MS=30000

# Plain HTTP on loopback for the demo. Both of these are "local development
# only" and neither is defaulted on in the server.
OPENCALC_ALLOW_PLAIN_CALLBACKS=1
OPENCALC_ALLOWED_HOSTS=host,127.0.0.1,localhost
